# ────────────────────────────────────────────────────────────────
# IBSAM® Portfolio Ecosystem — environment template
# Copy to `.env` (never commit a real .env). All values below are
# optional: the application boots with zero external credentials.
# ────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
# Public origin used for canonical URLs, cookies and CORS. Set to the
# deployed URL in production (e.g. https://your-app.example.com).
PUBLIC_URL=http://localhost:3000
# Comma separated allowlist of additional browser origins (optional).
CORS_ORIGINS=

# Persistence (SQLite file storage, created automatically)
DATA_DIR=./data
DATABASE_FILE=./data/ibsam.db

# Sessions
SESSION_TTL_DAYS=7
# Optional first-run admin bootstrap. If both are set the account is
# created on boot; otherwise use the first-run setup screen at
# /admin/login (only available while no admin exists).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional transactional email for contact notifications.
# When absent, messages are stored in the database and marked as
# "delivery not configured" — nothing silently fails.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
MAIL_FROM=IBSAM® <no-reply@localhost>

# Optional managed PostgreSQL (Supabase). The bundled SQLite engine is
# used when this is empty. See docs/DEPLOYMENT.md.
DATABASE_URL=

# Optional object storage (Supabase Storage / S3). Local disk storage
# under DATA_DIR/uploads is used when these are empty.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
